datasource db {
  provider = "postgresql"
  // Neon（新加坡）：DATABASE_URL 用 Neon 連線視窗「Prisma」格式的連線池網址（主機名稱含 -pooler）。
  // Prisma 5.10 以後建表也能走連線池，不需要另外的 directUrl。
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PetType {
  DOG
  CAT
}

enum Role {
  PET_OWNER
  MERCHANT
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  // LINE 登入不一定提供 email，所以允許空值
  email         String?        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  avatar        String?
  role          Role           @default(PET_OWNER)
  points        Int            @default(100) // 註冊禮 100 點
  placeReports  PlaceReport[]
  reportFlags   PlaceReportFlag[]
  pointLedger   PointLedger[]
  pets          Pet[]
  virtualPets   VirtualPet[]
  inventory     Inventory[]
  rewardClaims  RewardClaim[]
  merchant      Merchant?
  appointments  Appointment[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ---- 登入（Auth.js / next-auth）使用的資料表 ----
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pet {
  id            String         @id @default(uuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  type          PetType
  breed         String?
  ageYears      Int?
  birthday      DateTime?
  weightKg      Float?
  avatar        String?
  notes         String?
  // 驅蟲預防藥
  medBrand      String?
  medLastDate   DateTime?
  vaccines      VaccineRecord[]
  virtualPet    VirtualPet?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([ownerId])
}

model VaccineRecord {
  id            String         @id @default(uuid())
  petId         String
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  vaccineName   String
  administeredAt DateTime
  nextDueDate   DateTime
  isNotified    Boolean        @default(false)
}

model Merchant {
  id            String         @id @default(uuid())
  ownerId       String         @unique
  owner         User           @relation(fields: [ownerId], references: [id])
  name          String
  category      String
  address       String
  latitude      Float
  longitude     Float
  rating        Float          @default(5.0)
  reviewCount   Int            @default(0)
  coverImage    String?
  services      Service[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
}

model Service {
  id            String         @id @default(uuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title         String
  durationMin   Int
  price         Float
}

model Appointment {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  scheduledAt   DateTime
  status        String         @default("CONFIRMED")
  pointsUsed    Int            @default(0)
  totalPrice    Float
  createdAt     DateTime       @default(now())
}

// 用量計數（例如 AI 查證每日上限）。key 例：grounding:2026-11-08:all、grounding:2026-11-08:ip:<雜湊>
model UsageCounter {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 飼主回報：某位飼主對某家店某一題的回答（是／否）。同一人同一店同一題只有一筆，可改答案。
// placeId 是 Google 地點 ID（Google 條款允許長期保存）。
model PlaceReport {
  id        String   @id @default(uuid())
  placeId   String
  // 登入者的回報有 userId；未登入的回報為空，靠 voterKey（瀏覽器識別碼）限制一人一票
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voterKey  String   // 登入者為 u:<userId>，未登入為 a:<瀏覽器識別碼>
  question  String
  answer    Boolean
  onSite    Boolean  @default(false) // 回報時人在店家附近（只比對距離，不保存位置）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([placeId, voterKey, question])
  @@index([placeId])
}

// 點數異動紀錄（每一次加點、扣點都留紀錄，方便查帳與防刷）
model PointLedger {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String   // 例如 report：飼主回報
  refId     String?  // 例如對應的 PlaceReport id
  // pending：確認中（先讓使用者看到，7 天後才入帳）；granted：已入帳；void：回報被多數推翻而取消
  status      String    @default("granted")
  availableAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([userId, reason, refId]) // 同一筆回報只能發一次點數
}

// 「這題可能已改變」：飼主覺得某家店某一題的回報過時或有誤
model PlaceReportFlag {
  id        String   @id @default(uuid())
  placeId   String
  question  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([placeId, question, userId])
  @@index([placeId])
}

// ---- 毛孩數位分身（點數兌換遊戲）----
// 每個寵物檔案一隻分身。會餓、會髒、會想你，但不會死；數值在讀取時依經過時間計算，不需要排程。
model VirtualPet {
  id           String    @id @default(uuid())
  petId        String    @unique
  pet          Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  species      String    // dog / cat
  headKey      String    // 頭型（依品種）
  coatKey      String    @default("default")
  fullness     Float     @default(80) // 飽足 0–100
  cleanliness  Float     @default(80) // 清潔 0–100
  mood         Float     @default(80) // 心情 0–100
  xp           Int       @default(0)  // 親密度經驗，只升不降
  dailyXp      Int       @default(0)
  dailyXpDate  String?   // 台灣日期 YYYY-MM-DD
  sparkleUntil DateTime? // 泡泡沐浴球的閃亮特效
  lastTickAt   DateTime  @default(now())
  lastPetAt    DateTime?
  lastPlayAt   DateTime?
  lastBathAt   DateTime?
  memorialAt   DateTime? // 彩虹橋紀念模式
  version      Int       @default(0) // 樂觀鎖：同時操作時只有一個會成功
  equipped     VirtualPetEquip[]
  events       PetCareEvent[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// 分身身上穿戴的物品（每個部位一件）
model VirtualPetEquip {
  vpetId String
  vpet   VirtualPet @relation(fields: [vpetId], references: [id], onDelete: Cascade)
  slot   String
  sku    String

  @@id([vpetId, slot])
}

// 飼主的物品（綁帳號，多隻寵物共用）
model Inventory {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       String
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, sku])
}

// 照顧紀錄（每日免費飼料次數、每日任務、防刷）
model PetCareEvent {
  id        String     @id @default(uuid())
  vpetId    String
  vpet      VirtualPet @relation(fields: [vpetId], references: [id], onDelete: Cascade)
  userId    String
  type      String     // feed / treat / bath / play / pet
  sku       String?
  dayKey    String     // 台灣日期 YYYY-MM-DD
  createdAt DateTime   @default(now())

  @@index([vpetId, dayKey])
  @@index([userId, dayKey])
}

// 一段期間只能領一次的獎勵（例如每天第一次回報送的零食）
model RewardClaim {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  periodKey String
  createdAt DateTime @default(now())

  @@id([userId, kind, periodKey])
}
