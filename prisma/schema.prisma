datasource db {
  provider  = "postgresql"
  // Supabase：DATABASE_URL 用 Transaction pooler（port 6543，加 ?pgbouncer=true）給網站連線，
  // DIRECT_URL 用 Session pooler（port 5432）給資料表遷移使用
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PetType {
  DOG
  CAT
}

enum Role {
  PET_OWNER
  MERCHANT
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  // LINE 登入不一定提供 email，所以允許空值
  email         String?        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  avatar        String?
  role          Role           @default(PET_OWNER)
  points        Int            @default(2000)
  pets          Pet[]
  merchant      Merchant?
  appointments  Appointment[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ---- 登入（Auth.js / next-auth）使用的資料表 ----
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pet {
  id            String         @id @default(uuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  type          PetType
  breed         String?
  ageYears      Int?
  birthday      DateTime?
  weightKg      Float?
  avatar        String?
  notes         String?
  // 驅蟲預防藥
  medBrand      String?
  medLastDate   DateTime?
  vaccines      VaccineRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([ownerId])
}

model VaccineRecord {
  id            String         @id @default(uuid())
  petId         String
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  vaccineName   String
  administeredAt DateTime
  nextDueDate   DateTime
  isNotified    Boolean        @default(false)
}

model Merchant {
  id            String         @id @default(uuid())
  ownerId       String         @unique
  owner         User           @relation(fields: [ownerId], references: [id])
  name          String
  category      String
  address       String
  latitude      Float
  longitude     Float
  rating        Float          @default(5.0)
  reviewCount   Int            @default(0)
  coverImage    String?
  services      Service[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
}

model Service {
  id            String         @id @default(uuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title         String
  durationMin   Int
  price         Float
}

model Appointment {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  scheduledAt   DateTime
  status        String         @default("CONFIRMED")
  pointsUsed    Int            @default(0)
  totalPrice    Float
  createdAt     DateTime       @default(now())
}

// 用量計數（例如 AI 查證每日上限）。key 例：grounding:2026-11-08:all、grounding:2026-11-08:ip:<雜湊>
model UsageCounter {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
