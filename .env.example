# 資料庫：Neon（新加坡）連線池網址，從 Neon 專案的 Connect 視窗複製（格式選 Connection string、開啟 Connection pooling）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# 瀏覽器載入地圖用，請在 Google Cloud 限制為只允許本站網域（HTTP referrer）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
# 伺服器端呼叫 Places API (New) 用，不可加 NEXT_PUBLIC_ 前綴；請限制為只能呼叫 Places API (New)
GOOGLE_MAPS_SERVER_KEY="your_server_side_maps_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
# 選填：指定 Gemini 模型，未設定時預設 gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"
